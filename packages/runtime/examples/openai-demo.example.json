{
  "contractVersion": "application-configuration.v2",
  "provenance": {
    "demoProfileVersion": "demo-profile.v2",
    "policyVersion": "demo-policy.v2"
  },
  "mode": "operator",
  "server": {
    "bind": "loopback",
    "port": 3100
