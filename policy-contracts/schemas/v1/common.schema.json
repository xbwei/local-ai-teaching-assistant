{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/laita/schemas/policy/v1/common.schema.json",
  "$defs": {
    "versionIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.v[1-9][0-9]*$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    }
  }
}
